{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivan-ai-os.local/schemas/decision-result.schema.json",
  "title": "DecisionResult",
  "type": "object",
  "required": [
    "decision",
    "confidence",
    "reasons",
    "policies"
  ],
  "properties": {
    "decision": {
      "enum": [
        "ALLOW",
        "DENY",
        "REQUIRE_HUMAN",
        "ESCALATE",
        "REVIEW"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provider": {
      "type": "string"
    },
    "latency_ms": {
      "type": "number"
    },
    "fallback_used": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}