# Sample values only. Keep the actual .env outside Git.
NODE_ENV=development
PORT=4310
HOST=127.0.0.1

# Mock mode returns REVIEW; Jev mode needs a real API key in the runtime secret store.
JEV_PROVIDER=mock
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=8000

POSTGRES_DB=ivan_ai_os
POSTGRES_USER=ivan_ai_os
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://ivan_ai_os:change-me@postgres:5432/ivan_ai_os
REDIS_URL=redis://redis:6379

OPENCLAW_BASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
