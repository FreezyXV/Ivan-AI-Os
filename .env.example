# Sample values only. Keep the actual .env outside Git.
NODE_ENV=development
PORT=4310
HOST=127.0.0.1

# Mock mode returns REVIEW; Jev mode needs a real API key in the runtime secret store.
JEV_PROVIDER=mock
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=8000
# Runtime paths only; provision the actual token outside Git (private 0700 directory).
IVAN_DECISION_TOKEN_FILE=
IVAN_AUDIT_PATH=
IVAN_WORKSPACE_ROOT=
IVAN_JEV_BUDGET_PATH=
# Planning conversion for the local 10 EUR cap; not an invoiced exchange rate.
JEV_USD_TO_EUR_BUDGET_RATE=1

POSTGRES_DB=ivan_ai_os
POSTGRES_USER=ivan_ai_os
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://ivan_ai_os:change-me@postgres:5432/ivan_ai_os
REDIS_URL=redis://redis:6379

OPENCLAW_BASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
