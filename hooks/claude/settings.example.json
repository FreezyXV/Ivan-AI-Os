{
  "env": { "IVAN_CLAUDE_HOOK_MODE": "shadow" },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/hooks/claude/pre-tool-use.mjs\"", "timeout": 5 }
        ]
      }
    ]
  }
}
