{
  "id": "ivan-ai-os-observer",
  "name": "Ivan AI OS Observer",
  "description": "Scoped advisory tool capture with redacted audit; inactive by default",
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": { "type": "boolean", "default": false },
      "agentId": { "type": "string", "minLength": 1 },
      "tools": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" } },
      "gatewayUrl": { "type": "string", "pattern": "^http://(127\\.0\\.0\\.1|\\[::1\\])(:[0-9]+)?/?$" },
      "auditPath": { "type": "string", "minLength": 1 },
      "timeoutMs": { "type": "integer", "minimum": 250, "maximum": 10000, "default": 3000 }
    },
    "additionalProperties": false
  }
}
